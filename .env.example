# Copy to .env.local and fill in. None of these are required for the
# default JSON-file persistence.

# Optional: override the path of the leads JSON file.
# LEADS_FILE_PATH=./data/leads.json

# Optional: if you swap src/lib/leads.ts to use Resend, set these.
# RESEND_API_KEY=
# LEAD_NOTIFICATION_TO=you@example.com
# LEAD_NOTIFICATION_FROM="Plumber Leads <leads@yourplumbingco.com>"
